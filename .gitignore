# Lambda dependencies (installed packages)
# These are installed via `pip install -r requirements.txt -t .` during build
# We only want to track the source files (lambda_function.py, requirements.txt), not the installed dependencies

# Ignore all Python packages and dependencies installed in lambda directories
infrastructure/lambda/**/__pycache__/
infrastructure/lambda/**/*.dist-info/
infrastructure/lambda/**/*.egg-info/
infrastructure/lambda/**/*.pyc
infrastructure/lambda/**/*.pyo
infrastructure/lambda/**/*.so
infrastructure/lambda/**/bin/
