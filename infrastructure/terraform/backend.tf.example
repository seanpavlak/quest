# Terraform Backend Configuration
# Copy this file to backend.tf and configure with your S3 bucket and DynamoDB table
# 
# Prerequisites:
# 1. Create an S3 bucket for storing Terraform state
# 2. Create a DynamoDB table for state locking
# 3. Configure appropriate IAM permissions
#
# Example:
# terraform {
#   backend "s3" {
#     bucket         = "your-terraform-state-bucket"
#     key            = "rearc-data-pipeline/terraform.tfstate"
#     region         = "us-east-1"
#     encrypt        = true
#     dynamodb_table = "terraform-state-lock"
#   }
# }
